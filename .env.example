# Copy to `.env` only if you want to run data-backed benchmark tasks locally.
# Public verification targets such as `make bootstrap`, `make test`, and
# `make release` rebuild the tracked release package without these values.

# Provider credentials
OPENROUTER_API_KEY=

# Local benchmark data roots
UNIMORAL_DATA_DIR=
SMID_DATA_DIR=
VALUEPRISM_DATA_FILE=
VALUEPRISM_RELEVANCE_FILE=
VALUEPRISM_VALENCE_FILE=
CCD_BENCH_DATA_FILE=
DENEVIL_DATA_FILE=

# Optional task-level overrides
VALUEPRISM_SPLIT=
UNIMORAL_LANGUAGE=
UNIMORAL_MODE=
CEI_PROMPT_PREFIX=
CEI_MIN_MAX_TOKENS=
CEI_TEMPERATURE=
